#!/bin/bash

# Opens the PR that bumps the version. Merging it releases that version, through
# .github/workflows/release.yml.
#
# With test, makes a throwaway tag instead, to try a branch on another repository.
# dist/ is only ever committed on tags, so a workflow cannot use a branch directly.
#
# Usage:
#
# script/release [patch|minor|major]
# script/release test

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Named everywhere, so that this does not depend on any local push settings.
remote=origin
main=main

fail() {
	echo "$1" >&2
	exit 1
}

require_clean_tree() {
	[ -z "$(git status --porcelain)" ] || fail "Commit or stash your changes first."
}

make_test_tag() {
	require_clean_tree
	local branch tag
	branch="$(git branch --show-current)"
	[ -n "$branch" ] || fail "Run this from a branch."
	tag="test-$(git rev-parse --short HEAD)"

	# shellcheck disable=SC2064 # the branch must be the one from right now
	trap "git switch --quiet --force '$branch'" EXIT
	git switch --quiet --detach
	npm ci
	npm run package
	git add --force dist
	git commit --quiet --message "Test $tag"
	git tag --force --annotate "$tag" --message "$tag"
	git switch --quiet "$branch"
	trap - EXIT

	git push --force "$remote" "$tag"

	echo
	echo "To try it: uses: luanpotter/dart-benchmark-action@$tag"
	echo "To remove it: git push $remote --delete $tag"
}

next_version() {
	local current="$1" bump="$2" major minor patch
	IFS=. read -r major minor patch <<<"$current"
	case "$bump" in
	major) echo "$((major + 1)).0.0" ;;
	minor) echo "$major.$((minor + 1)).0" ;;
	patch) echo "$major.$minor.$((patch + 1))" ;;
	*) fail "Unknown bump: $bump. Use patch, minor or major." ;;
	esac
}

ask_bump() {
	local current="$1"
	{
		echo "The current version is $current."
		echo "  patch: $(next_version "$current" patch)"
		echo "  minor: $(next_version "$current" minor)"
		echo "  major: $(next_version "$current" major)"
	} >&2
	local bump
	read -r -p "How do you want to bump it? " bump
	echo "$bump"
}

open_release_pr() {
	[ "$(git branch --show-current)" = "$main" ] || fail "Run this from $main."
	require_clean_tree
	git fetch --quiet "$remote" "$main"
	[ "$(git rev-parse HEAD)" = "$(git rev-parse "$remote/$main")" ] ||
		fail "Your $main is not the same as $remote/$main."

	local current version branch
	current="$(node -p "require('./package.json').version")"
	version="$(next_version "$current" "${1:-$(ask_bump "$current")}")"
	branch="release/v$version"

	script/check.sh

	git switch --quiet --create "$branch"
	npm version "$version" --no-git-tag-version >/dev/null
	git add package.json package-lock.json
	git commit --quiet --message "chore: Release $version"
	git push "$remote" "$branch"
	gh pr create --base "$main" --head "$branch" \
		--title "chore: Release $version" \
		--body "Merging this releases v$version."
	git switch --quiet "$main"
}

if [ "${1:-}" = test ]; then
	make_test_tag
else
	open_release_pr "${1:-}"
fi
