{
	"name": "dart-benchmark-action",
	"description": "A GitHub Action to run benchmarks on Dart/Flutter projects and libraries.",
	"version": "0.1.14",
	"author": "Luan Nico",
	"private": true,
	"homepage": "https://github.com/luanpotter/dart-benchmark-action",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luanpotter/dart-benchmark-action.git"
	},
	"bugs": {
		"url": "https://github.com/luanpotter/dart-benchmark-action/issues"
	},
	"keywords": [
		"dart",
		"benchmark",
		"GitHub",
		"action"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "npm run format:check && npm run lint && npm run biome && npm run typecheck && npm run test",
		"biome": "npx biome format --error-on-warnings --no-errors-on-unmatched && npx biome lint --error-on-warnings --no-errors-on-unmatched",
		"typecheck": "npx tsc --noEmit",
		"ci-test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
		"coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
		"format:write": "npx prettier --write .",
		"format:check": "npx prettier --check .",
		"lint": "npx eslint . -c ./.github/linters/eslint.config.mjs",
		"local-action": "npx local-action . src/main.ts .env",
		"package": "rm -rf dist && npx rollup --config rollup.config.mjs",
		"package:watch": "npx rollup --config rollup.config.mjs --watch",
		"test": "NODE_OPTIONS=--experimental-vm-modules npx jest"
	},
	"license": "MIT",
	"jest": {
		"preset": "ts-jest/presets/default-esm",
		"verbose": true,
		"clearMocks": true,
		"testEnvironment": "node",
		"moduleFileExtensions": [
			"js",
			"ts"
		],
		"testMatch": [
			"**/*.test.ts"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/dist/"
		],
		"moduleNameMapper": {
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"useESM": true
				}
			]
		},
		"coverageReporters": [
			"json-summary",
			"text",
			"lcov"
		],
		"collectCoverage": true,
		"collectCoverageFrom": [
			"./src/**"
		]
	},
	"overrides": {
		"@github/local-action": {
			"undici": "^6.29.1"
		},
		"glob": "^14.0.3",
		"minimatch": "^11.0.3"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/exec": "^3.0.0",
		"@actions/github": "^9.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@eslint/js": "^10.0.1",
		"@github/local-action": "^7.0.1",
		"@jest/globals": "^30.5.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"make-coverage-badge": "^1.2.0",
		"prettier": "^3.9.10",
		"prettier-eslint": "^17.1.2",
		"rollup": "^4.67.4",
		"rollup-plugin-license": "^3.7.1",
		"ts-jest": "^29.4.15",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3"
	}
}
